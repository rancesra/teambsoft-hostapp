# Dónde corre cada módulo. El Host App los carga dentro de un iframe desde estas direcciones.
# Si un módulo no tiene dirección, el Host App muestra "todavía no está conectado" en vez de fallar.
# Los puertos son los fijos del contrato v1.2 (requisito 1). Estas direcciones también son las únicas
# desde las que el Host App acepta el mensaje "navegar".
VITE_MODULO_CATALOGO=http://localhost:5173
VITE_MODULO_BUSQUEDA=http://localhost:5174
VITE_MODULO_CARRO=http://localhost:5175
# El login (contrato v1.3, sección 5): el realm "tienda" de Keycloak y el cliente del navegador.
# Keycloak corre en el docker-compose del backend o en el de integración. Si se borra esta línea, el
# Host App funciona igual, sin el botón "Iniciar sesión".
VITE_KEYCLOAK_URL=http://localhost:8180/realms/tienda
VITE_KEYCLOAK_CLIENTE=tienda-web

# Copia este archivo como .env (en esta misma carpeta) y llénalo. El .env no se sube a GitHub.
# Los valores reales se comparten por un canal privado, nunca en el repositorio.

# --- Credenciales (obligatorias) ---
# Usa solo letras y números: la clave de RabbitMQ también va dentro de la URL amqp:// de Búsqueda.
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# Secreto con el que Carrito firma y valida sus JWT. El token de desarrollo del frontend de Carrito
# (VITE_DEV_TOKEN) tiene que estar firmado con este mismo secreto.
JWT_SECRET=

# --- Consola de Keycloak (opcional) ---
# Por defecto admin / admin. Solo protege la consola de administración, no a los usuarios de la tienda.
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin

# --- De dónde se construye cada backend (opcional) ---
# Por defecto, la rama principal de cada repositorio en GitHub. Para probar cambios que todavía no
# están en GitHub, se pone la carpeta local, por ejemplo C:/Users/tu-usuario/Desktop/teambsoft-backend
# CATALOGO_CONTEXTO=https://github.com/rancesra/teambsoft-backend.git#main
# BUSQUEDA_CONTEXTO=https://github.com/Tavolistar/Grupoa_Busqueda.git#main
# CARRITO_CONTEXTO=https://github.com/camiloherrera-dev/PROYECTO-ING-SOFTWARE-II.git#develop
# EUREKA_CONTEXTO=https://github.com/rancesra/teambsoft-backend.git#main:eureka

# --- Puertos de este computador (opcional) ---
# Cámbialos solo si ya están ocupados. Si cambias el de Kong, los frontends tienen que apuntar al nuevo.
# KONG_PUERTO=8000
# RABBIT_CONSOLA_PUERTO=15672
# EUREKA_PUERTO=8761
# Si el 5173 está ocupado: cambia este y pon la misma dirección en URL_CATALOGO_WEB (http://localhost:<puerto>).
# CATALOGO_WEB_PUERTO=5173

# --- De dónde se construye cada frontend (opcional) ---
# Igual que los backends: por defecto, la rama principal de cada repositorio en GitHub.
# HOSTAPP_CONTEXTO=https://github.com/rancesra/teambsoft-hostapp.git#main
# CATALOGO_WEB_CONTEXTO=https://github.com/rancesra/teambsoft-frontend.git#main
# BUSQUEDA_WEB_CONTEXTO=https://github.com/Tavolistar/Grupoa_Busqueda.git#main:busqueda-frontend
# CARRITO_WEB_CONTEXTO=https://github.com/camiloherrera-dev/PROYECTO-ING-SOFTWARE-II.git#develop:Frontend

# --- Publicar la tienda en internet (contrato del Host App v1.4, sección 11) ---
# Solo para "docker compose --profile publico up -d --build". Sin estas líneas, todo queda en localhost.
# Cambia "midominio.com" por el dominio de Cloudflare. Van con https y sin "/" al final.
# URL_TIENDA=https://tienda.midominio.com
# URL_CATALOGO_WEB=https://catalogo.midominio.com
# URL_BUSQUEDA_WEB=https://busqueda.midominio.com
# URL_CARRO_WEB=https://carrito.midominio.com
# URL_LOGIN=https://login.midominio.com
# El token del túnel: panel de Cloudflare → Zero Trust → Networks → Tunnels → el túnel → instalar
# con Docker. Es la cadena larga que va después de "--token". Es un secreto: no se comparte.
# TUNEL_TOKEN=
# Claves de los usuarios de prueba de la tienda. Publicada, cualquiera puede abrir el login: cámbialas.
# CLAVE_ADMIN_TIENDA=
# CLAVE_CLIENTE_TIENDA=
# Y la de la consola de Keycloak (arriba, KEYCLOAK_ADMIN_PASSWORD), aunque esa consola no se publica.

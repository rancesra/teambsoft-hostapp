# Copia este archivo como .env (en esta misma carpeta) y llénalo. El .env no se sube a GitHub.
# Los valores reales se comparten por un canal privado, nunca en el repositorio.

# --- Credenciales (obligatorias) ---
# Usa solo letras y números: la clave de RabbitMQ también va dentro de la URL amqp:// de Búsqueda.
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# Secreto con el que Carrito firma y valida sus JWT. El token de desarrollo del frontend de Carrito
# (VITE_DEV_TOKEN) tiene que estar firmado con este mismo secreto.
JWT_SECRET=

# --- Consola de Keycloak (opcional) ---
# Por defecto admin / admin. Solo protege la consola de administración, no a los usuarios de la tienda.
# KEYCLOAK_ADMIN=admin
# KEYCLOAK_ADMIN_PASSWORD=admin

# --- De dónde se construye cada backend (opcional) ---
# Por defecto, la rama principal de cada repositorio en GitHub. Para probar cambios que todavía no
# están en GitHub, se pone la carpeta local, por ejemplo C:/Users/tu-usuario/Desktop/teambsoft-backend
# CATALOGO_CONTEXTO=https://github.com/rancesra/teambsoft-backend.git#main
# BUSQUEDA_CONTEXTO=https://github.com/Tavolistar/Grupoa_Busqueda.git#main
# CARRITO_CONTEXTO=https://github.com/camiloherrera-dev/PROYECTO-ING-SOFTWARE-II.git#develop

# --- Puertos de este computador (opcional) ---
# Cámbialos solo si ya están ocupados. Si cambias el de Kong, los frontends tienen que apuntar al nuevo.
# KONG_PUERTO=8000
# RABBIT_CONSOLA_PUERTO=15672
